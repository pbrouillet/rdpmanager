+/**
+ * @brief Enable or disable navigate passthrough mode (WebView only).
+ *
+ * When enabled, navigation events are still fired to the application callback,
+ * but the WebView is allowed to navigate freely instead of blocking. This is
+ * useful for multi-step external flows (e.g. OAuth) where the WebView must
+ * follow redirects while the app observes navigation URLs.
+ *
+ * @param window The window number
+ * @param status True to enable, False to disable
+ *
+ * @example webui_set_navigate_passthrough(myWindow, true);
+ */
+WEBUI_EXPORT void webui_set_navigate_passthrough(size_t window, bool status);
+
