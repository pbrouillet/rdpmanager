+void webui_set_navigate_passthrough(size_t window, bool status) {
+
+    #ifdef WEBUI_LOG
+    _webui_log_info("[User] webui_set_navigate_passthrough([%zu], %d)\n", window, status);
+    #endif
+
+    // Initialization
+    _webui_init();
+
+    // Dereference
+    if (_webui_mutex_app_is_exit_now(WEBUI_MUTEX_GET_STATUS) || _webui.wins[window] == NULL)
+        return;
+    _webui_window_t* win = _webui.wins[window];
+
+    win->navigate_passthrough = status;
+}
