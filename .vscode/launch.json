{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug: WebUI RDP Client (GDB)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/webui-rdp-client",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "DISPLAY",
                    "value": ":0"
                },
                {
                    "name": "GTK_PATH",
                    "value": ""
                },
                {
                    "name": "GTK_EXE_PREFIX",
                    "value": ""
                },
                {
                    "name": "GIO_MODULE_DIR",
                    "value": ""
                },
                {
                    "name": "GTK_IM_MODULE_FILE",
                    "value": ""
                },
                {
                    "name": "LOCPATH",
                    "value": ""
                },
                {
                    "name": "GSETTINGS_SCHEMA_DIR",
                    "value": ""
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Ninja: Build (Debug)",
            "miDebuggerPath": "/usr/bin/gdb",
            "logging": {
                "moduleLoad": false,
                "trace": false,
                "engineLogging": false,
                "programOutput": true,
                "exceptions": true
            }
        },
        {
            "name": "Debug: WebUI RDP Client (LLDB)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/webui-rdp-client",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "DISPLAY",
                    "value": ":0"
                },
                {
                    "name": "GTK_PATH",
                    "value": ""
                },
                {
                    "name": "GTK_EXE_PREFIX",
                    "value": ""
                },
                {
                    "name": "GIO_MODULE_DIR",
                    "value": ""
                },
                {
                    "name": "GTK_IM_MODULE_FILE",
                    "value": ""
                },
                {
                    "name": "LOCPATH",
                    "value": ""
                },
                {
                    "name": "GSETTINGS_SCHEMA_DIR",
                    "value": ""
                }
            ],
            "externalConsole": false,
            "MIMode": "lldb",
            "preLaunchTask": "Ninja: Build (Debug)",
            "miDebuggerPath": "/usr/bin/lldb"
        },
        {
            "name": "Debug: WebUI RDP Client (CodeLLDB)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/webui-rdp-client",
            "args": [],
            "cwd": "${workspaceFolder}",
            "env": {
                "DISPLAY": ":0",
                "GTK_PATH": "",
                "GTK_EXE_PREFIX": "",
                "GIO_MODULE_DIR": "",
                "GTK_IM_MODULE_FILE": "",
                "LOCPATH": "",
                "GSETTINGS_SCHEMA_DIR": ""
            },
            "preLaunchTask": "Ninja: Build (Debug)",
            "sourceMap": {},
            "relativePathBase": "${workspaceFolder}"
        },
        {
            "name": "Attach to Process",
            "type": "cppdbg",
            "request": "attach",
            "program": "${workspaceFolder}/build/webui-rdp-client",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Debug: With Custom RDP Target",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/webui-rdp-client",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "DISPLAY",
                    "value": ":0"
                },
                {
                    "name": "RDP_DEFAULT_HOST",
                    "value": "${input:rdpHost}"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "preLaunchTask": "Ninja: Build (Debug)",
            "miDebuggerPath": "/usr/bin/gdb"
        }
    ],
    "inputs": [
        {
            "id": "rdpHost",
            "type": "promptString",
            "description": "Enter the RDP host to connect to",
            "default": "192.168.1.100"
        }
    ]
}
